# ============================================================
# KING-TV BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================
# Copy this file to '.env' or configure these environment variables
# in your IDE / deployment environment before running the server.

# ------------------------------------------------------------
# 1. DATABASE CONFIGURATION (TiDB Cloud / MySQL) - REQUIRED
# ------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/kings_tv_db?sslMode=VERIFY_IDENTITY&useSSL=true&requireSSL=true&useUnicode=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=your_tidb_username_here
SPRING_DATASOURCE_PASSWORD=your_tidb_password_here

# ------------------------------------------------------------
# 2. HIKARI CONNECTION POOL & JPA CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5
SPRING_JPA_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# ------------------------------------------------------------
# 3. SECURITY & JWT CONFIGURATION (OPTIONAL / RECOMMENDED)
# ------------------------------------------------------------
# Minimum 256-bit (32+ character) secret key
JWT_SECRET=super_secret_kings_tv_token_key_1234_long_string_required_for_spring_boot_security
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ------------------------------------------------------------
# 4. SERVER & NETWORK CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------
PORT=8080

# ------------------------------------------------------------
# 5. THIRD-PARTY EXTERNAL APIS (OPTIONAL)
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
UPTIMEROBOT_API_KEY=your_uptimerobot_api_key_here

# ------------------------------------------------------------
# 6. AWS S3 STORAGE CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------
AWS_S3_ENABLED=false
AWS_S3_ENDPOINT=
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_BUCKET=
AWS_S3_CDN_URL=
